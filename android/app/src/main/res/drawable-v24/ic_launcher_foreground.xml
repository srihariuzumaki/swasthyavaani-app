        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="16.2"
        android:translateY="16.2">
        <!-- Simplified representation of स्व - using a health/plus symbol -->
        <path
            android:pathData="M54,32 L54,26 L60,26 L60,32 L66,32 L66,38 L60,38 L60,44 L54,44 L54,38 L48,38 L48,32 Z"
            android:fillColor="#FFFFFF"
            android:fillType="nonZero" />
        <!-- Alternative: Pill capsule shape -->
        <path
            android:pathData="M30,34 C30,31 32,28 35,28 L55,28 C58,28 60,31 60,34 L60,42 C60,45 58,48 55,48 L35,48 C32,48 30,45 30,42 Z"
