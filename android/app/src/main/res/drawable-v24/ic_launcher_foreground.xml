    android:viewportHeight="108"
    android:viewportWidth="108">
    <!-- Swasthya Vaani Logo - Rounded square with gradient -->
    <!-- The foreground should be white text/symbol on the gradient background -->
    <!-- Since Devanagari text is complex, using a simple health symbol -->
